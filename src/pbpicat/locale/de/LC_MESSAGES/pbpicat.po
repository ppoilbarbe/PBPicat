#: src/pbpicat/ui/main_window.py:163
msgid "Sidecar filter…"
msgstr "Sidecar-Filter…"

# ==AUTO== Automatically translated
#: src/pbpicat/ui/main_window.py:166
msgid ""
"<b>Sidecar content filter</b><br>Python regular expression applied to the "
"<i>content</i> of sidecar files.<br>Only files with at least one sidecar "
"whose content matches are shown.<br>Files with no sidecar are always hidden "
"when a filter is active.<br><tt>.*</tt> matches across line breaks (re."
"DOTALL).<br>Case-insensitive (re.IGNORECASE), including accented characters."
"<br>Leave empty to show all files."
msgstr ""
"<b>Sidecar-Inhaltsfilter</b><br>Python-regulaerer Ausdruck, der auf den "
"<i>Inhalt</i> der Sidecar-Dateien angewendet wird.<br>Nur Dateien, bei denen "
"mindestens ein Sidecar uebereinstimmt, werden angezeigt.<br>Dateien ohne "
"Sidecar werden bei aktivem Filter immer ausgeblendet.<br><tt>.*</tt> passt "
"ueber Zeilenumbrueche hinweg (re.DOTALL).<br>Gross-/Kleinschreibung "
"ignoriert (re.IGNORECASE), einschliesslich Akzentzeichen.<br>Leer lassen, um "
"alle Dateien anzuzeigen."

