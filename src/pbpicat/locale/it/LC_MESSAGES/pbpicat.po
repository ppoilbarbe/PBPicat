#: src/pbpicat/ui/main_window.py:166
# ==AUTO== Automatically translated
msgid ""
"<b>Sidecar content filter</b><br>Python regular expression applied to the "
"<i>content</i> of sidecar files.<br>Only files with at least one sidecar "
"whose content matches are shown.<br>Files with no sidecar are always hidden "
"when a filter is active.<br><tt>.*</tt> matches across line breaks (re."
"DOTALL).<br>Case-insensitive (re.IGNORECASE), including accented characters."
"<br>Leave empty to show all files."
msgstr ""
"<b>Filtro contenuto sidecar</b><br>Espressione regolare Python applicata al "
"<i>contenuto</i> dei file sidecar.<br>Vengono mostrati solo i file con "
"almeno un sidecar corrispondente.<br>I file senza sidecar sono sempre "
"nascosti quando un filtro è attivo.<br><tt>.*</tt> corrisponde ai ritorni a "
"capo (re.DOTALL).<br>Senza distinzione maiuscole/minuscole (re.IGNORECASE), "
"inclusi caratteri accentati.<br>Lasciare vuoto per mostrare tutti i file."

