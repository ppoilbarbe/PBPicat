# ==AUTO== Automatically translated
#: src/pbpicat/ui/main_window.py:337
msgid ""
"<b>Sidecar content filter</b><br>Python regular expression applied to the "
"<i>content</i> of sidecar files.<br>Only files with at least one sidecar "
"whose content matches are shown.<br>Files with no sidecar are always hidden "
"when a filter is active.<br><tt>.*</tt> matches across line breaks "
"(re.DOTALL).<br>Case-insensitive (re.IGNORECASE), including accented "
"characters.<br>Leave empty to show all files."
msgstr ""
"<b>Filtro de contenido sidecar</b><br>Expresión regular de Python aplicada "
"al <i>contenido</i> de los archivos sidecar.<br>Solo se muestran los "
"archivos con al menos un sidecar cuyo contenido coincida.<br>Los archivos "
"sin sidecar siempre se ocultan cuando hay un filtro activo.<br><tt>.*</tt> "
"coincide en saltos de línea (re.DOTALL).<br>Sin distinción de "
"mayúsculas/minúsculas (re.IGNORECASE), incluyendo caracteres "
"acentuados.<br>Dejar vacío para mostrar todos los archivos."

