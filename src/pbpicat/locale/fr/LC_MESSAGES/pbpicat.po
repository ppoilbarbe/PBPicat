#: src/pbpicat/ui/main_window.py:431
msgid ""
"<b>PBPicat</b><br>Image and video file renaming tool using a structured "
"schema.<br><br>Supported formats: images (JPEG, PNG, HEIC, RAW…) and videos "
"(MP4, MOV…),<br>with associated sidecar files (XMP, DOP, PP3…)."
msgstr ""
"<b>PBPicat</b><br>Outil de renommage de fichiers images et vidéos selon un "
"schéma structuré.<br><br>Formats supportés : images (JPEG, PNG, HEIC, RAW…) "
"et vidéos (MP4, MOV…),<br>avec fichiers sidecar associés (XMP, DOP, PP3…)."

