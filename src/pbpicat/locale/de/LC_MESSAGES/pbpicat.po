#: src/pbpicat/ui/main_window.py:502
# ==AUTO== Automatically translated
msgid ""
"<b>PBPicat</b><br>Image and video file renaming tool using a structured "
"schema.<br><br>Supported formats: images (JPEG, PNG, HEIC, RAW…) and videos "
"(MP4, MOV…),<br>with associated sidecar files (XMP, DOP, PP3…)."
msgstr ""
"<b>PBPicat</b><br>Werkzeug zum Umbenennen von Bild- und Videodateien anhand "
"eines strukturierten Schemas.<br><br>Unterstuetzte Formate: Bilder (JPEG, "
"PNG, HEIC, RAW…) und Videos (MP4, MOV…),<br>mit zugehoerigen Sidecar-Dateien "
"(XMP, DOP, PP3…)."

